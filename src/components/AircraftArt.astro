---
// Rotating aircraft wireframes with a small HUD. Drawing code: src/scripts/aircraft.ts
// Drag to spin/tilt, tap or click to switch aircraft.
const names = ['B-1B Lancer', 'A-10 Thunderbolt II', 'B-2 Spirit', 'F-22 Raptor', 'SR-71 Blackbird'];
---
<div class="hero-art aircraft-art" aria-hidden="true">
  <canvas></canvas>
  <span class="hud-hint">Drag to rotate · Tap to switch</span>
  <svg class="adi" viewBox="-24 -24 48 48">
    <defs><clipPath id="adi-clip"><circle r="21" /></clipPath></defs>
    <g clip-path="url(#adi-clip)">
      <g data-horizon>
        <rect class="adi-ground" x="-80" y="0" width="160" height="80" />
        <path class="adi-line" d="M-80 0H80" />
        <path class="adi-ladder" d="M-6 -9H6M-4 -18H4M-6 9H6M-4 18H4" />
      </g>
    </g>
    <circle class="adi-ring" r="21" />
    <path class="adi-plane" d="M-13 0h7l2.5 3.5L9 0h4M0 -1.2v2.4" transform="translate(-2 0)" />
  </svg>
  <div class="hud">
    <span class="hud-title" data-name>{names[0]}</span>
    <span><span data-label>Wing sweep</span> <b data-value>25.0°</b></span>
    <span>HDG <b data-hdg>035</b> · BNK <b data-bnk>0°</b></span>
    <span>THR <b data-thr>MIL</b> · <b data-mach>M0.85</b></span>
    <span class="pips">{names.map((_, i) => <i data-pip data-on={i === 0 ? '' : undefined}></i>)}</span>
  </div>
  <span class="hud-corner tl"></span><span class="hud-corner tr"></span><span class="hud-corner bl"></span><span class="hud-corner br"></span>
</div>
<script>
  import '../scripts/aircraft';
</script>
