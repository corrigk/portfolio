---
import '../styles/global.css';
import { site, url, defaultTheme, lockTheme } from '../lib';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { title?: string; description?: string; image?: string; }
const { title, description = site.tagline, image = site.ogImage } = Astro.props;
const full = title ? `${title} · ${site.name}` : `${site.name} · Portfolio`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(url(image), Astro.site).href;
---
<!doctype html>
<html lang="en" data-theme={defaultTheme} data-locked={lockTheme ? 'true' : 'false'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=DM+Sans:wght@400;500;700&family=Fraunces:opsz,wght@9..144,400..700&family=IBM+Plex+Sans:wght@400;500;600&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap" />
    <script is:inline define:vars={{ defaultTheme, locked: !!lockTheme }}>
      // Runs before paint to avoid a flash of the wrong theme.
      try {
        var t = locked ? defaultTheme : (localStorage.getItem('theme') || defaultTheme);
        var m = localStorage.getItem('mode');
        document.documentElement.dataset.theme = t;
        if (m === 'light' || m === 'dark') document.documentElement.dataset.mode = m;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <script>
      import '../scripts/theme';
    </script>
  </body>
</html>
