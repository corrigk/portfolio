---
// Embroidered-style mission patch generated from a project's title, category and date.
interface Props { title: string; category: string; date: Date; status?: string; size?: number }
const { title, category, date, status = 'complete', size = 128 } = Astro.props;
const id = 'p' + Math.abs([...title].reduce((h, c) => (h * 31 + c.charCodeAt(0)) | 0, 7)).toString(36);
const top = title.toUpperCase();
// shrink the lettering so long titles still fit on the top arc
const topSize = top.length <= 18 ? 9.5 : Math.max(5.6, (9.5 * 18) / top.length);
const bottom = `${category.toUpperCase()} · ${date.getUTCFullYear()}${status === 'in-progress' ? ' · ACTIVE' : ''}`;
const icons: Record<string, string> = {
  software: 'M-9 -6l-7 6 7 6M9 -6l7 6-7 6M3 -10l-6 20',
  hardware: 'M6 -12a7 7 0 0 0-8 9l-10 10 4 4 10-10a7 7 0 0 0 9-8l-4 4-4-1-1-4z',
  fun: 'M0 -13l3.8 8 8.7 1.1-6.4 6 1.7 8.6L0 6.4l-7.8 4.3 1.7-8.6-6.4-6 8.7-1.1z',
};
---
<svg class="patch" width={size} height={size} viewBox="-64 -64 128 128" role="img" aria-label={`Mission patch: ${title}`}>
  <defs>
    <path id={`${id}-t`} d="M-44 0a44 44 0 0 1 88 0" />
    <path id={`${id}-b`} d="M-46 0a46 46 0 0 0 92 0" />
  </defs>
  <circle r="62" class="patch-edge" />
  <circle r="60" class="patch-fill" />
  <circle r="34" class="patch-inner" />
  <text class="patch-text" style={`font-size:${topSize.toFixed(2)}px;letter-spacing:${top.length > 18 ? 0.06 : 0.14}em`}><textPath href={`#${id}-t`} startOffset="50%" text-anchor="middle">{top}</textPath></text>
  <text class="patch-text small"><textPath href={`#${id}-b`} startOffset="50%" text-anchor="middle" dominant-baseline="hanging">{bottom}</textPath></text>
  <path d={icons[category] ?? icons.fun} class="patch-icon" />
  <g class="patch-stars"><circle cx="-52" cy="4" r="1.6" /><circle cx="52" cy="4" r="1.6" /></g>
</svg>
