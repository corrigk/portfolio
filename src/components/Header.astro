---
import { site, url, lockTheme, THEMES } from '../lib';
const path = Astro.url.pathname;
const links = [['Projects', '/projects/'], ['About', '/about/'], ['Contact', '/contact/']];
const isActive = (h: string) => path.startsWith(url(h));
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={url('/')}>{site.name}</a>
    <nav aria-label="Main">
      {links.map(([l, h]) => <a href={url(h)} aria-current={isActive(h) ? 'page' : undefined}>{l}</a>)}
    </nav>
    <div class="controls">
      {!lockTheme && (
        <div class="theme-switch" role="group" aria-label="Theme">
          {THEMES.map((t) => <button type="button" data-set-theme={t} aria-pressed="false" title={`${t} theme`}>{t}</button>)}
        </div>
      )}
      <button type="button" id="mode-toggle" class="icon-btn" aria-label="Toggle light/dark mode" title="Light / dark / auto">
        <span aria-hidden="true" id="mode-icon">◐</span>
      </button>
    </div>
  </div>
</header>
